; Engine configuration file.
; Hunter, made from godot-game-starter (Milestone 0, Nov 21, 2026). Package ID, APK filename and
; updater URL are filled in by CI from the GitHub repo name.
; Why 720x1280 (docs/BUILD_SPEC.md hard rules): Hunter's base canvas is 720x1280, not the starter's
; 540x960. stretch/scale 1.3333 keeps every starter screen and button the same size on the phone
; (the starter's UI and touch rule, 72 units >= 48 dp, were tuned for a 540-wide canvas); without
; it, all UI would shrink to 75% and buttons would drop under 48 dp. 3D renders at full window
; resolution either way. See docs/DECISIONS.md (Nov 21).

config_version=5

[application]

config/name="Hunter"
config/display_title="The Devil You Owe"
run/main_scene="res://scenes/boot.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
run/max_fps=60
config/icon="res://icon.svg"

[audio]

general/ios/mix_with_others=true

buses/default_bus_layout="res://default_bus_layout.tres"

[autoload]

Controls="*res://scripts/controls.gd"
Settings="*res://scripts/settings.gd"
Save="*res://scripts/save_game.gd"
Audio="*res://scripts/audio.gd"
Subs="*res://scripts/subs.gd"
Feel="*res://scripts/feel.gd"
Telemetry="*res://scripts/telemetry.gd"
Loader="*res://scripts/loader.gd"
Battery="*res://scripts/battery.gd"
Updater="*res://scripts/updater.gd"
DebugMenu="*res://scripts/debug_menu.gd"
Autoplay="*res://scripts/autoplay.gd"

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/size/window_width_override=405
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/stretch/scale=1.3333
window/handheld/orientation=1

[input_devices]

pointing/emulate_mouse_from_touch=true
pointing/emulate_touch_from_mouse=false

[application.config]

quit_on_go_back=false

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
